# CampusNav Sentinel — Configuration
# Copy to .env and adjust values as needed.

# Perception
CN_TARGET_WIDTH=640
CN_ROI_FRACTION=0.6
CN_DETECTOR_MODEL=yolov8n.pt
CN_DETECTOR_CONFIDENCE=0.35
CN_DETECTOR_DEVICE=
CN_MOTION_THRESHOLD=0.02

# Pipeline
CN_FRAME_SKIP=1
CN_MAX_FRAMES=0

# API
CN_API_HOST=0.0.0.0
CN_API_PORT=8000
CN_LOG_LEVEL=INFO

# Nebius AI Cloud (NVIDIA models)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_ENABLED=true
NEBIUS_INTERVAL=5

# AWS (set CN_AWS_ENABLED=true to activate)
CN_AWS_ENABLED=false
CN_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
